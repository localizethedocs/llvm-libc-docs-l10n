#: ../../../configure.rst:8
msgid "Configure Options"
msgstr ""

#: ../../../configure.rst:10
msgid ""
"Below is the full set of options one can use to configure the libc build. An "
"option can be given an explicit value on the CMake command line using the "
"following syntax:"
msgstr ""

#: ../../../configure.rst:18
msgid "For example:"
msgstr ""

#: ../../../configure.rst:24
msgid ""
"See the main ``config/config.json``, and the platform and architecture "
"specific overrides in ``config/<platform>/config.json`` and ``config/"
"<platform>/<arch>/config.json,`` to learn about the defaults for your "
"platform and target."
msgstr ""

#: ../../../configure.rst:28
msgid "**\"assert\" options**"
msgstr ""

#: ../../../configure.rst:29
msgid "``LIBC_COPT_HARDENING_MODE``: Hardening mode for the library."
msgstr ""

#: ../../../configure.rst:30
msgid ""
"``LIBC_COPT_USE_C_ASSERT``: Use the system assert macro for LIBC_ASSERT."
msgstr ""

#: ../../../configure.rst:31
msgid "**\"baremetal\" options**"
msgstr ""

#: ../../../configure.rst:32
msgid ""
"``LIBC_COPT_BAREMETAL_HEAP_ENABLE_FREESTORE_ROTATION``: Enable rotational "
"dual freestore in FreeListHeap to delay reuse of freed memory. This, when "
"combined with sanitizers, helps detect Use-After-Free (UAF) bugs more "
"reliably by preventing rapid reallocation of recently freed blocks. It costs "
"one extra flag bit in the block header, which doubles the minimum allocation "
"alignment on 32-bit targets."
msgstr ""

#: ../../../configure.rst:33
msgid "**\"codegen\" options**"
msgstr ""

#: ../../../configure.rst:34
msgid ""
"``LIBC_CONF_ENABLE_STRONG_STACK_PROTECTOR``: Enable -fstack-protector-strong "
"to defend against stack smashing attack."
msgstr ""

#: ../../../configure.rst:35
msgid ""
"``LIBC_CONF_KEEP_FRAME_POINTER``: Keep frame pointer in functions for better "
"debugging experience."
msgstr ""

#: ../../../configure.rst:36
msgid "**\"ctype\" options**"
msgstr ""

#: ../../../configure.rst:37
msgid ""
"``LIBC_CONF_CTYPE_SMALLER_ASCII``: Shrinks b36_char_to_int by assuming the "
"character encoding is ASCII."
msgstr ""

#: ../../../configure.rst:38
msgid "**\"errno\" options**"
msgstr ""

#: ../../../configure.rst:39
msgid ""
"``LIBC_CONF_ERRNO_MODE``: The implementation used for errno, acceptable "
"values are LIBC_ERRNO_MODE_DEFAULT, LIBC_ERRNO_MODE_UNDEFINED, "
"LIBC_ERRNO_MODE_THREAD_LOCAL, LIBC_ERRNO_MODE_SHARED, "
"LIBC_ERRNO_MODE_EXTERNAL, and LIBC_ERRNO_MODE_SYSTEM_INLINE."
msgstr ""

#: ../../../configure.rst:40
msgid "**\"fenv\" options**"
msgstr ""

#: ../../../configure.rst:41
msgid ""
"``LIBC_CONF_TRAP_ON_RAISE_FP_EXCEPT``: Trap with SIGFPE when feraiseexcept "
"is called with unmasked floating point exceptions, similar to glibc's "
"behavior.  This is currently working only on x86 with SSE."
msgstr ""

#: ../../../configure.rst:42
msgid "**\"general\" options**"
msgstr ""

#: ../../../configure.rst:43
msgid ""
"``LIBC_ADD_NULL_CHECKS``: Add nullptr checks in the library's "
"implementations to some functions for which passing nullptr is undefined "
"behavior."
msgstr ""

#: ../../../configure.rst:44
msgid "**\"math\" options**"
msgstr ""

#: ../../../configure.rst:45
msgid ""
"``LIBC_CONF_FREXP_INF_NAN_EXPONENT``: The value written back to the second "
"parameter when calling frexp/frexpf/frexpl` with `+/-Inf`/`NaN` is "
"unspecified.  Configure an explicit exp value for Inf/NaN inputs."
msgstr ""

#: ../../../configure.rst:46
msgid ""
"``LIBC_CONF_MATH_OPTIMIZATIONS``: Configure optimizations for math "
"functions. Values accepted are LIBC_MATH_SKIP_ACCURATE_PASS, "
"LIBC_MATH_SMALL_TABLES, LIBC_MATH_NO_ERRNO, LIBC_MATH_NO_EXCEPT, "
"LIBC_MATH_FAST, LIBC_MATH_INTERMEDIATE_COMP_IN_FLOAT, and "
"LIBC_MATH_ASSUME_ROUND_NEAREST_ONLY."
msgstr ""

#: ../../../configure.rst:47
msgid ""
"``LIBC_CONF_MATH_USE_SYSTEM_FENV``: Use C standard fenv.h calls from the "
"system libc instead our internal fenv implementations."
msgstr ""

#: ../../../configure.rst:48
msgid "**\"printf\" options**"
msgstr ""

#: ../../../configure.rst:49
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_FIXED_POINT``: Disable printing fixed point "
"values in printf and friends."
msgstr ""

#: ../../../configure.rst:50
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_FLOAT``: Disable printing floating point values "
"in printf and friends."
msgstr ""

#: ../../../configure.rst:51
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_INDEX_MODE``: Disable index mode in the printf "
"format string."
msgstr ""

#: ../../../configure.rst:52
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_STRERROR``: Disable handling of %m to print "
"strerror in printf and friends."
msgstr ""

#: ../../../configure.rst:53
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_WIDE``: Disable handling wide characters for "
"printf and friends."
msgstr ""

#: ../../../configure.rst:54
msgid ""
"``LIBC_CONF_PRINTF_DISABLE_WRITE_INT``: Disable handling of %n in printf "
"format string."
msgstr ""

#: ../../../configure.rst:55
msgid ""
"``LIBC_CONF_PRINTF_FLOAT_TO_STR_NO_SPECIALIZE_LD``: Use the same mode for "
"double and long double in printf."
msgstr ""

#: ../../../configure.rst:56
msgid ""
"``LIBC_CONF_PRINTF_FLOAT_TO_STR_USE_DYADIC_FLOAT``: Use dyadic float for "
"faster and smaller but less accurate printf doubles."
msgstr ""

#: ../../../configure.rst:57
msgid ""
"``LIBC_CONF_PRINTF_FLOAT_TO_STR_USE_FLOAT320``: Use an alternative printf "
"float implementation based on 320-bit floats"
msgstr ""

#: ../../../configure.rst:58
msgid ""
"``LIBC_CONF_PRINTF_FLOAT_TO_STR_USE_MEGA_LONG_DOUBLE_TABLE``: Use large "
"table for better printf long double performance."
msgstr ""

#: ../../../configure.rst:59
msgid ""
"``LIBC_CONF_PRINTF_MODULAR``: Split printf implementation into modules that "
"can be lazily linked in."
msgstr ""

#: ../../../configure.rst:60
msgid ""
"``LIBC_CONF_PRINTF_RUNTIME_DISPATCH``: Use dynamic dispatch for the output "
"mechanism to reduce code size."
msgstr ""

#: ../../../configure.rst:61
msgid ""
"``LIBC_COPT_PRINTF_DISABLE_BITINT``: Disable bitint length modifiers to "
"reduce code size. Specifically the wNUM and wfNUM modifiers."
msgstr ""

#: ../../../configure.rst:62
msgid "**\"pthread\" options**"
msgstr ""

#: ../../../configure.rst:63
msgid ""
"``LIBC_CONF_RAW_MUTEX_DEFAULT_SPIN_COUNT``: Default number of spins before "
"blocking if a mutex is in contention (default to 100)."
msgstr ""

#: ../../../configure.rst:64
msgid ""
"``LIBC_CONF_RWLOCK_DEFAULT_SPIN_COUNT``: Default number of spins before "
"blocking if a rwlock is in contention (default to 100)."
msgstr ""

#: ../../../configure.rst:65
msgid ""
"``LIBC_CONF_TIMEOUT_ENSURE_MONOTONICITY``: Automatically adjust timeout to "
"CLOCK_MONOTONIC (default to true). POSIX API may require CLOCK_REALTIME, "
"which can be unstable and leading to unexpected behavior. This option will "
"convert the real-time timestamp to monotonic timestamp relative to the time "
"of call."
msgstr ""

#: ../../../configure.rst:66
msgid "**\"qsort\" options**"
msgstr ""

#: ../../../configure.rst:67
msgid ""
"``LIBC_CONF_QSORT_IMPL``: Configures sorting algorithm for qsort and "
"qsort_r. Values accepted are LIBC_QSORT_QUICK_SORT, LIBC_QSORT_HEAP_SORT."
msgstr ""

#: ../../../configure.rst:68
msgid "**\"scanf\" options**"
msgstr ""

#: ../../../configure.rst:69
msgid ""
"``LIBC_CONF_SCANF_DISABLE_FLOAT``: Disable parsing floating point values in "
"scanf and friends."
msgstr ""

#: ../../../configure.rst:70
msgid ""
"``LIBC_CONF_SCANF_DISABLE_INDEX_MODE``: Disable index mode in the scanf "
"format string."
msgstr ""

#: ../../../configure.rst:71
msgid ""
"``LIBC_CONF_SCANF_PROVIDE_ISOC99_ALIASES``: Add __isoc99_* aliases for "
"scanf's functions."
msgstr ""

#: ../../../configure.rst:72
msgid "**\"setjmp\" options**"
msgstr ""

#: ../../../configure.rst:73
msgid ""
"``LIBC_CONF_SETJMP_AARCH64_RESTORE_PLATFORM_REGISTER``: Make setjmp save the "
"value of x18, and longjmp restore it. The AArch64 ABI delegates this "
"register to platform ABIs, which can choose whether to make it caller-saved."
msgstr ""

#: ../../../configure.rst:74
msgid "**\"str_to_float\" options**"
msgstr ""

#: ../../../configure.rst:75
msgid ""
"``LIBC_CONF_STRTOFLOAT_DISABLE_CLINGER_FAST_PATH``: Disable Clinger's fast "
"path for string to float conversion."
msgstr ""

#: ../../../configure.rst:76
msgid ""
"``LIBC_CONF_STRTOFLOAT_DISABLE_EISEL_LEMIRE``: Disable Eisel-Lemire "
"algorithm for string to float conversion."
msgstr ""

#: ../../../configure.rst:77
msgid ""
"``LIBC_CONF_STRTOFLOAT_DISABLE_SIMPLE_DECIMAL_CONVERSION``: Disable simple "
"decimal conversion for string to float conversion."
msgstr ""

#: ../../../configure.rst:78
msgid "**\"string\" options**"
msgstr ""

#: ../../../configure.rst:79
msgid ""
"``LIBC_CONF_FIND_FIRST_CHARACTER_IMPL``: Selects the implementation for find-"
"first-character-related functions: 'element', 'word', 'clang_vector', or "
"'arch_vector'."
msgstr ""

#: ../../../configure.rst:80
msgid ""
"``LIBC_CONF_MEMCPY_X86_USE_NTA_STORES``: Use Non-temporal stores in memcpy "
"on x86 to improve performance of large copies."
msgstr ""

#: ../../../configure.rst:81
msgid ""
"``LIBC_CONF_MEMSET_X86_USE_SOFTWARE_PREFETCHING``: Inserts prefetch for "
"write instructions (PREFETCHW) for memset on x86 to recover performance when "
"hardware prefetcher is disabled."
msgstr ""

#: ../../../configure.rst:82
msgid ""
"``LIBC_CONF_STRING_LENGTH_IMPL``: Selects the implementation for string-"
"length: 'element', 'word', 'clang_vector', or 'arch_vector'."
msgstr ""

#: ../../../configure.rst:83
msgid ""
"``LIBC_CONF_USE_MEM_BUILTINS``: Use builtins for memory utility functions."
msgstr ""

#: ../../../configure.rst:84
msgid "**\"threads\" options**"
msgstr ""

#: ../../../configure.rst:85
msgid ""
"``LIBC_CONF_THREAD_MODE``: The implementation used for Mutex, acceptable "
"values are LIBC_THREAD_MODE_PLATFORM, LIBC_THREAD_MODE_SINGLE, and "
"LIBC_THREAD_MODE_EXTERNAL."
msgstr ""

#: ../../../configure.rst:86
msgid "**\"wctype\" options**"
msgstr ""

#: ../../../configure.rst:87
msgid ""
"``LIBC_CONF_WCTYPE_MODE``: The implementation used for wctype, acceptable "
"values are LIBC_WCTYPE_MODE_ASCII and LIBC_WCTYPE_MODE_UTF8."
msgstr ""
